---
const links = [
  { label: 'Work', href: '/work' },
  { label: 'Services', href: '/services' },
  { label: 'Downloads', href: '/downloads' },
  { label: 'Blog', href: '/blog' },
  { label: 'Answers', href: '/answers' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' }
];
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="ft__copy">© {year} VigVibe LLC · Scott Vigneault</div>
  <nav class="ft__nav">
    {links.map(l => <a href={l.href}>{l.label}</a>)}
  </nav>
</footer>

<style>
  .ft {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 34px var(--pad-x); background: var(--ink-deep);
    border-top: 1px solid var(--line);
  }
  .ft__copy { font-size: 13px; color: var(--text-faint); }
  .ft__nav { display: flex; flex-wrap: wrap; gap: 24px; }
  .ft__nav a { font-size: 13px; font-weight: 500; color: #E6EAEA; }
  .ft__nav a:hover { color: var(--teal-light); }
  @media (max-width: 900px) {
    .ft { flex-direction: column-reverse; align-items: flex-start; gap: 18px; }
    .ft__nav { gap: 16px; }
  }
</style>
