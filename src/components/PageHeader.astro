---
import PhotoBand from './PhotoBand.astro';
const { title, intro, image = '', eyebrow = '', focal = 'center 58%' } = Astro.props;
---
<PhotoBand image={image} focal={focal} height="320px">
  {eyebrow && <p class="eyebrow" style="margin-bottom:14px">{eyebrow}</p>}
  <h1 style="font-weight:800;font-size:44px;line-height:1.08;color:#fff;margin-bottom:12px">{title}</h1>
  {intro && <p style="font-size:16px;line-height:1.6;color:var(--text-soft);max-width:64ch">{intro}</p>}
</PhotoBand>
