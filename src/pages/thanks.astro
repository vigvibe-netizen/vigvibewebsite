---
import Base from '../layouts/Base.astro';
---
<Base
  title="Got it"
  description="Your message is in my inbox. I reply within one business day."
  tone="contact"
>
  <section class="wrap" style="padding-top:120px;padding-bottom:140px;max-width:640px">
    <p class="eyebrow" style="margin-bottom:18px">Message received</p>
    <h1 style="font-weight:800;font-size:44px;line-height:1.08;margin-bottom:18px">Got it. It is in my inbox.</h1>
    <p style="font-size:18px;line-height:1.6;color:var(--text-mute);margin-bottom:32px">I will read it today and reply within one business day with what I think the project actually is and what it would take.</p>
    <div class="row">
      <a class="btn btn--ghost" href="/work">See the work while you wait</a>
      <a class="btn btn--teal" href="/">Back home</a>
    </div>
  </section>
</Base>
