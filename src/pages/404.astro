---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page is not here.">
  <section class="wrap" style="max-width:640px;margin:0 auto;padding-top:96px;padding-bottom:120px">
    <p class="eyebrow" style="margin-bottom:18px">404</p>
    <h1 style="font-weight:800;font-size:40px;line-height:1.1;margin-bottom:16px">That page is not here.</h1>
    <p style="font-size:17px;line-height:1.65;color:var(--text-mute);margin-bottom:28px">It may have moved when the site was rebuilt. The work is the most likely thing you were after.</p>
    <div class="row">
      <a class="btn btn--action" href="/work">See the work</a>
      <a class="btn btn--ghost" href="/">Home</a>
    </div>
  </section>
</Base>
