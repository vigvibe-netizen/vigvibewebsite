---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const answers = (await getCollection('answers')).sort((a, b) => a.data.order - b.data.order);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: answers.map(a => ({
    '@type': 'Question',
    name: a.data.question,
    acceptedAnswer: { '@type': 'Answer', text: a.data.answer }
  }))
};
---
<Base
  title="Questions I get asked"
  description="Straight answers on hiring design help, fixing creative workflow, and using AI without wasting a quarter."
  schema={schema}
>
  <section class="wrap ans">
    <h1 style="font-weight:800;font-size:38px;line-height:1.14;color:var(--text-bright);max-width:22ch;margin-bottom:14px">Questions I get asked</h1>
    <p style="font-size:17px;line-height:1.6;color:var(--text-mute);max-width:64ch;margin-bottom:30px">Straight answers on hiring design help, fixing creative workflow, and using AI without wasting a quarter. Every answer links to the longer piece.</p>

    <div style="border-top:1px solid var(--line)">
      {answers.map(a => (
        <div id={a.id} style="padding:26px 0;border-bottom:1px solid var(--line)">
          <div class={a.data.priority ? 'eyebrow eyebrow--orange' : 'eyebrow'} style="font-size:10.5px;margin-bottom:12px">{a.data.category}</div>
          <h2 style="font-weight:700;font-size:22px;margin-bottom:10px">{a.data.question}</h2>
          <p style="font-size:15.5px;line-height:1.7;color:var(--text-mute);margin-bottom:12px">{a.data.answer}</p>
          {a.data.linkHref && (
            <a href={a.data.linkHref} style={a.data.priority ? 'font-size:13.5px;font-weight:600;color:var(--orange)' : 'font-size:13.5px;font-weight:600'}>{a.data.linkLabel}</a>
          )}
        </div>
      ))}
    </div>

    <div class="card card--priority" style="margin-top:12px;display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap">
      <div>
        <h3 style="font-weight:700;font-size:20px;margin-bottom:6px">Question not here?</h3>
        <p style="font-size:14.5px;line-height:1.55;color:var(--text-mute)">Describe the project in two sentences. I will tell you what it actually is.</p>
      </div>
      <a class="btn btn--action" href="/contact" style="font-size:15px;white-space:nowrap">Tell me what you need</a>
    </div>
  </section>
</Base>

<style>
  .ans { max-width: 900px; margin: 0 auto; padding-top: 44px; padding-bottom: 56px; }
</style>
