---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter(p => !p.data.draft).map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const typeLabel = { 'field-note': 'Field note', playbook: 'Playbook', answer: 'Answer' };
const fmt = x => x.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.seoDescription,
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: 'Scott Vigneault', url: 'https://vigvibe.com/about' },
  publisher: { '@type': 'Organization', name: 'VigVibe' }
};
const faqSchema = d.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faqs.map(x => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } }))
} : null;
const howToSchema = d.steps.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: d.title,
  description: d.shortAnswer || d.excerpt,
  step: d.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.body }))
} : null;
---
<Base title={d.title} description={d.seoDescription} image={d.cover} schema={articleSchema}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}

  <article class="art wrap">
    <div style="font-size:12.5px;color:var(--text-dim);margin-bottom:18px">
      <a href="/blog">← This week in AI…</a> · <span style="color:var(--teal-light)">{typeLabel[d.type]}</span>
    </div>
    <h1 style="font-weight:800;font-size:38px;line-height:1.14;color:var(--text-bright);max-width:26ch;margin-bottom:18px">{d.title}</h1>
    <div class="art__meta">
      <span style="color:#C3CBCC;font-weight:600">Scott Vigneault</span><span>·</span>
      <span>{fmt(d.date)}</span><span>·</span><span>{d.readingTime}</span>
    </div>

    {d.shortAnswer && (
      <div class="answerblock">
        <div class="eyebrow" style="font-size:11px;margin-bottom:12px">{d.steps.length > 0 ? 'In short' : 'Short answer'}</div>
        <p style="font-size:17px;line-height:1.6;color:#E6EAEA">{d.shortAnswer}</p>
      </div>
    )}

    <div class="prose"><Content /></div>

    {d.steps.length > 0 && (
      <div class="steps">
        {d.steps.map((s, i) => (
          <div class="step">
            <div class={i === d.steps.length - 1 ? 'step__n step__n--last' : 'step__n'}>{i + 1}</div>
            <div>
              <h3 style="font-weight:700;font-size:17px;margin-bottom:5px">{s.title}</h3>
              <p style="font-size:15px;line-height:1.65;color:var(--text-mute)">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    )}

    {d.faqs.length > 0 && (
      <div class="card" style="margin:34px 0;border-top-color:var(--teal)">
        <div class="eyebrow" style="font-size:11px;margin-bottom:16px">Related questions</div>
        {d.faqs.map((x, i) => (
          <div style={i === d.faqs.length - 1 ? '' : 'padding-bottom:14px;margin-bottom:14px;border-bottom:1px solid var(--line)'}>
            <div style="font-size:15px;font-weight:600;color:var(--text);margin-bottom:6px">{x.q}</div>
            <p style="font-size:14.5px;line-height:1.6;color:var(--text-dim)">{x.a}</p>
          </div>
        ))}
      </div>
    )}

    <div class="author">
      <div class="author__pic">
        <img src="/images/scott-vigneault-portrait.jpg" alt="Scott Vigneault" width="64" height="64" />
      </div>
      <div>
        <div style="font-family:var(--font-display);font-weight:700;font-size:17px;margin-bottom:6px">Scott Vigneault</div>
        <p style="font-size:14.5px;line-height:1.65;color:var(--text-mute);margin-bottom:10px">Twenty years leading in-house creative for B2B marketing teams, most recently as Creative Director at a global software company. Now takes creative direction, presentation design, and creative-ops work one project at a time.</p>
        <div class="row" style="gap:16px;font-size:13px;font-weight:600">
          <a href="/about">About Scott →</a>
          <a href="/work">Selected work →</a>
        </div>
      </div>
    </div>
  </article>

  <Newsletter heading="This week in AI…" body="Twice a month. One workflow fix, one tool worth the time, one thing I got wrong." />
</Base>

<style>
  .art { max-width: 820px; margin: 0 auto; padding-top: 48px; }
  .art__meta {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding-bottom: 24px; border-bottom: 1px solid var(--line);
    font-size: 13px; color: var(--text-dim);
  }
  .answerblock {
    margin: 26px 0 30px; background: #101B1D; border: 1px solid #33403F;
    border-left: 3px solid var(--teal); border-radius: 14px; padding: 24px 26px;
  }
  .steps { display: flex; flex-direction: column; gap: 20px; margin: 8px 0 34px; }
  .step { display: flex; gap: 16px; }
  .step__n {
    flex: none; width: 30px; height: 30px; border-radius: 50%;
    border: 1px solid var(--teal); color: var(--teal-light);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 700; font-size: 14px;
  }
  .step__n--last { border-color: var(--orange); color: var(--orange); }
  .author {
    display: flex; gap: 20px; align-items: flex-start;
    background: #101B1D; border: 1px solid #33403F; border-radius: 14px;
    padding: 24px 26px; margin-bottom: 34px;
  }
  .author__pic {
    width: 64px; height: 64px; flex: none; border-radius: 50%; overflow: hidden;
    border: 1px solid #33403F; background: var(--surface-sunk);
  }
  .author__pic img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) { .author { flex-direction: column; } }
</style>
