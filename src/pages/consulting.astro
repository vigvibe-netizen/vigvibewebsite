---
import Base from '../layouts/Base.astro';

const areas = [
  {
    number: '01', title: 'Briefs that answer the important questions.',
    body: 'Agree on the audience, problem, message, deliverables, deadline, and decision-maker before the work begins. Give urgent requests enough detail to make good decisions.',
    output: 'A practical brief and intake checklist.'
  },
  {
    number: '02', title: 'Strategy the whole team can use.',
    body: 'Connect the business objective to a customer need and a clear next action. Bring requesters, marketing, creative, and approvers into the conversation when their input matters.',
    output: 'A shared direction and review responsibilities.'
  },
  {
    number: '03', title: 'Copy with a point. Design with a purpose.',
    body: 'Turn product features into useful answers. Develop concise headlines, emails, ads, and social copy, with longer content where people need more explanation or evidence.',
    output: 'A message hierarchy and creative direction.'
  },
  {
    number: '04', title: 'Websites that follow the customer’s questions.',
    body: 'Review the journey from first visit to next step. Make it easier to understand the offer, find proof, compare options, and take action through clear content, navigation, and UX/UI.',
    output: 'A customer journey and page priorities.'
  },
  {
    number: '05', title: 'A brand system people can work with.',
    body: 'Give teams useful guidelines, examples, and templates for presentations, documents, and campaigns. Make consistent work easier to create across departments.',
    output: 'A usable brand and template system.'
  },
  {
    number: '06', title: 'AI with a clear job to do.',
    body: 'Use AI to support research, briefing, copy exploration, and repeatable tasks. Define the inputs, review points, and human decisions so another tool doesn’t become another handoff.',
    output: 'A repeatable workflow with human review.'
  }
];
const questions = [
  { question: 'What’s in it for me?', answer: 'Lead with the benefit the customer cares about.' },
  { question: 'Why should I believe you?', answer: 'Put relevant proof next to the promise.' },
  { question: 'Is this right for my situation?', answer: 'Explain who the offer serves and when it fits.' },
  { question: 'What do I do next?', answer: 'Give the page, email, or campaign one clear next step.' }
];
const steps = [
  { title: 'Look at the real work.', body: 'Bring a recent brief, campaign, webpage, or revision trail. We look at where information, decisions, and handoffs break down.' },
  { title: 'Agree on the first fix.', body: 'Choose a specific problem, involve the right people, and define the scope, deliverables, and signs of improvement.' },
  { title: 'Make it usable.', body: 'Build the brief, message structure, review process, or template with the people who will use it. Try it on real work.' },
  { title: 'See what changed.', body: 'Compare against the starting point: clarification loops, revisions, approval time, or customer actions. Use the result to decide what needs attention next.' }
];
const faqs = [
  { q: 'Is this for an internal team or an agency?', a: 'Both. I help internal marketing and creative teams work together, and help agencies improve the handoff between clients, account teams, and the people creating the work.' },
  { q: 'Can we start with one problem?', a: 'Yes. One recurring brief problem, a confusing webpage, conflicting feedback, or inconsistent templates is a useful place to begin. We agree the scope before work starts.' },
  { q: 'Can you help create the work, too?', a: 'Yes. My experience includes creative direction and hands-on design, presentations, campaigns, and brand systems. We can scope advice, implementation, or both.' },
  { q: 'Do we need new software?', a: 'We start by looking at your current process and tools. A clearer brief or approval decision may solve the problem. If a tool would help, we decide what it needs to do before choosing it.' }
];
const schema = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Consulting for creative and marketing teams',
  description: 'Creative and marketing consulting for clearer briefs, customer-focused content, website journeys, stakeholder reviews, brand systems, and practical AI workflows.',
  url: 'https://vigvibe.com/consulting',
  provider: { '@type': 'Person', name: 'Scott Vigneault', url: 'https://vigvibe.com/about' },
  serviceType: 'Creative and marketing consulting'
};
---
<Base
  title="Consulting for Creative & Marketing Teams"
  description="Better briefs, customer-focused copy, clearer website journeys, and brand systems your team can use. Creative and marketing consulting with Scott Vigneault."
  active="Consulting"
  schema={schema}
>
  <div class="consulting-page">
  <section class="wrap consulting-hero" aria-labelledby="consulting-title">
    <div class="consulting-width">
      <p class="eyebrow">Consulting for creative &amp; marketing teams</p>
      <h1 id="consulting-title">Better creative work starts with <span>better questions.</span></h1>
      <p class="hero-lead">Clearer briefs. Sharper messages. Less back-and-forth.</p>
      <p class="hero-body">I help creative and marketing teams ask the right questions, agree on what the customer needs, and build a clearer path from request to finished work.</p>
      <div class="hero-actions">
        <a class="btn btn--action" href="#start-a-conversation">Tell me where the work gets stuck</a>
        <a class="text-link" href="#how-i-help">See how I can help <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="wrap consulting-section" aria-labelledby="friction-title">
    <div class="consulting-width friction-panel">
      <div>
        <p class="eyebrow eyebrow--orange">The problem behind the rush</p>
        <h2 id="friction-title">The deadline is clear.<br />The request often isn’t.</h2>
      </div>
      <div class="section-copy">
        <p>Creative gets an urgent request. The audience is vague. The message is unsettled. Someone who needs to approve the work sees it after the design is done.</p>
        <p>Then come the revisions, conflicting feedback, and another round of questions.</p>
        <p><strong>A better process makes the important decisions earlier—while there’s still time to use the answers.</strong></p>
      </div>
    </div>
  </section>

  <section id="how-i-help" class="wrap consulting-section" aria-labelledby="help-title">
    <div class="consulting-width">
      <div class="section-intro">
        <p class="eyebrow">Where I can help</p>
        <h2 id="help-title">Connect the brief, the message,<br class="desktop-break" /> and the way the work gets done.</h2>
        <p>Start with the part that needs attention. Each engagement is scoped around your team’s work.</p>
      </div>
      <div class="consulting-grid">
        {areas.map(area => (
          <article class="consulting-area">
            <span class="area-number" aria-hidden="true">{area.number}</span>
            <h3>{area.title}</h3>
            <p>{area.body}</p>
            <p class="area-output"><span>What we can build</span>{area.output}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap consulting-section" aria-labelledby="customer-title">
    <div class="consulting-width customer-panel">
      <div class="section-intro">
        <p class="eyebrow eyebrow--orange">Keep the customer in the conversation</p>
        <h2 id="customer-title">“What’s in it for me?”<br />is a useful place to start.</h2>
        <p>What question brought someone to your website, email, or paper? Answer it early. Give them a concise, useful point, then the detail they need to make a decision.</p>
      </div>
      <dl class="question-list">
        {questions.map(item => <div><dt>{item.question}</dt><dd>{item.answer}</dd></div>)}
      </dl>
      <div class="message-example">
        <p class="example-label">Illustrative copy exercise</p>
        <div class="example-grid">
          <div><span>Feature-led</span><p>“A platform with automated reporting.”</p></div>
          <div><span>Customer-led</span><p>“See which campaigns need attention without rebuilding a spreadsheet every Monday.”</p></div>
        </div>
        <p class="example-note">Use the benefit only when the product can deliver it. Short copy still needs a true promise and supporting proof.</p>
      </div>
    </div>
  </section>

  <section class="wrap consulting-section" aria-labelledby="experience-title">
    <div class="consulting-width experience-panel">
      <div>
        <p class="eyebrow">Built from experience inside marketing</p>
        <h2 id="experience-title">I’ve been responsible for the work—and the system behind it.</h2>
      </div>
      <div class="section-copy">
        <p>At Loftware, I worked across creative briefs, marketing strategy, copy, design, and website journeys. I helped teams focus on the customer’s questions and brought stakeholders into the work at the points where their decisions mattered.</p>
        <p>I also developed brand guidelines and reusable templates for teams across the company: presentations, documents, and campaign materials that made consistent work easier to produce.</p>
        <a class="text-link" href="/work/brand-identity/branding-identity-template-redesign-2023">See the brand and template work <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="wrap consulting-section" aria-labelledby="process-title">
    <div class="consulting-width">
      <div class="section-intro">
        <p class="eyebrow">How we work together</p>
        <h2 id="process-title">Start with one piece of real work.</h2>
      </div>
      <ol class="consulting-steps">
        {steps.map((step, i) => <li><span class="step-number" aria-hidden="true">0{i + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}
      </ol>
      <p class="measurement-note">We agree on what to measure before changing the process. Faster production is useful when the work stays accurate, on brand, and relevant to the customer.</p>
    </div>
  </section>

  <section class="wrap consulting-section" aria-labelledby="questions-title">
    <div class="consulting-width consulting-faqs">
      <div><p class="eyebrow">A few practical questions</p><h2 id="questions-title">Before we start.</h2></div>
      <div>{faqs.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
        <p class="resources-link">Looking for the free AI skills? <a href="/downloads">They’re still here <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section id="start-a-conversation" class="wrap consulting-section consulting-contact" aria-labelledby="start-title">
    <div class="consulting-width contact-panel">
      <div class="section-intro">
        <p class="eyebrow eyebrow--orange">A practical starting point</p>
        <h2 id="start-title">Where does your team<br />keep getting stuck?</h2>
        <p>An unclear brief. Conflicting feedback. A website that leaves people with questions. Tell me about one example, and we can discuss a sensible first step.</p>
        <a class="text-link" href="/creative-bottleneck">Prefer a conversation? Request a 15-minute call <span aria-hidden="true">→</span></a>
      </div>
      <form name="need" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field" class="consulting-form">
        <input type="hidden" name="form-name" value="need" />
        <input type="hidden" name="need" value="consulting for creative and marketing teams" />
        <p hidden><label>Leave blank <input name="bot-field" /></label></p>
        <div><label for="consulting-what">What’s happening? A few sentences is enough.</label><textarea id="consulting-what" name="what" rows="5" required placeholder="Our requests arrive without enough detail, and the team keeps redesigning work after new stakeholders join the review."></textarea></div>
        <div><label for="consulting-email">Your email</label><input id="consulting-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></div>
        <button type="submit" class="btn btn--action">Let’s talk about the work</button>
        <p class="form-note">I’ll use these details to respond to your inquiry. No newsletter signup.</p>
      </form>
    </div>
  </section>
  </div>
</Base>

<style>
  .consulting-page {
    position: relative;
    isolation: isolate;
    background-color: #07131f;
    background-image:
      linear-gradient(to bottom, rgba(5,15,22,.06), rgba(5,15,22,.18)),
      url('/images/consulting-geometry-bg.svg');
    background-size: auto, 1600px 900px;
    background-position: center, center top;
    background-repeat: no-repeat, repeat-y;
  }
  .consulting-page::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(70% 24% at 50% 0%, rgba(0,178,190,.10), transparent 70%),
      linear-gradient(to bottom, transparent 0%, rgba(5,15,22,.18) 100%);
  }
  .consulting-width { max-width: 1180px; margin-inline: auto; }
  .consulting-hero { padding-block: 88px 52px; }
  .consulting-hero h1 { max-width: 15ch; font-size: clamp(42px, 5.2vw, 68px); line-height: 1.07; font-weight: 800; margin: 20px 0 24px; }
  .consulting-hero h1 span { color: var(--teal-light); }
  .hero-lead { font-family: var(--font-display); font-size: 24px; line-height: 1.4; font-weight: 700; margin-bottom: 18px; }
  .hero-body { max-width: 58ch; font-size: 18px; color: var(--text-soft); }
  .hero-actions { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-top: 30px; }
  .text-link { font-size: 15px; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; line-height: 1.6; }
  .consulting-section { padding-block: 40px; scroll-margin-top: 108px; }
  .consulting-section h2 { font-size: clamp(28px, 3.1vw, 40px); line-height: 1.18; font-weight: 800; margin: 14px 0 20px; }
  .consulting-section h3 { font-size: 22px; line-height: 1.3; font-weight: 700; }
  .section-intro { max-width: 740px; margin-bottom: 30px; }
  .section-intro > p:not(.eyebrow), .section-copy p { font-size: 17px; line-height: 1.75; color: var(--text-soft); }
  .section-copy p + p { margin-top: 18px; }
  .section-copy .text-link { display: inline-block; margin-top: 22px; }
  .friction-panel, .experience-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 54px; padding-top: 34px; border-top: 1px solid var(--line-strong); }
  .consulting-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .consulting-area { display: flex; flex-direction: column; padding: 26px; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: rgba(8,20,31,.74); backdrop-filter: blur(10px); }
  .area-number { font-family: var(--font-mono); font-size: 13px; color: var(--teal-light); margin-bottom: 18px; }
  .consulting-area h3 { margin-bottom: 14px; }
  .consulting-area > p { color: var(--text-soft); font-size: 15px; line-height: 1.75; }
  .consulting-area .area-output { margin-top: auto; padding-top: 22px; font-size: 14px; }
  .area-output span { display: block; margin-bottom: 8px; padding-top: 14px; border-top: 1px solid var(--line-strong); color: var(--teal-light); font-size: 12px; font-weight: 700; }
  .customer-panel, .contact-panel { padding: 40px; border: 1px solid var(--line-strong); border-radius: var(--r-lg); background: rgba(8,20,31,.72); backdrop-filter: blur(12px); }
  .question-list { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 44px; margin: 26px 0 34px; }
  .question-list div { border-top: 1px solid var(--line-strong); padding-top: 18px; }
  .question-list dt { font-family: var(--font-display); font-weight: 700; font-size: 20px; margin-bottom: 8px; }
  .question-list dd { margin: 0; color: var(--text-soft); font-size: 16px; }
  .message-example { border-left: 3px solid var(--orange); background: rgba(247,144,28,.05); padding: 22px 24px; }
  .example-label { color: var(--orange); font-size: 12px; font-weight: 700; margin-bottom: 18px; }
  .example-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  .example-grid span { display: block; color: var(--text-mute); font-size: 12px; margin-bottom: 8px; }
  .example-grid p { font-size: 18px; line-height: 1.6; }
  .example-note { font-size: 13px; line-height: 1.65; color: var(--text-mute); margin-top: 18px; }
  .consulting-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 30px 46px; }
  .consulting-steps li { display: flex; gap: 20px; padding-top: 22px; border-top: 1px solid var(--line-strong); }
  .step-number { color: var(--orange); font: 600 15px var(--font-mono); padding-top: 5px; }
  .consulting-steps p { font-size: 16px; color: var(--text-soft); line-height: 1.75; margin-top: 12px; }
  .measurement-note { margin-top: 30px; max-width: 80ch; color: var(--text-mute); font-size: 15px; line-height: 1.75; }
  .consulting-faqs { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; }
  details { border-bottom: 1px solid var(--line-strong); }
  summary { padding: 20px 0; font-size: 17px; font-weight: 600; cursor: pointer; }
  details p { color: var(--text-soft); padding-bottom: 20px; font-size: 16px; line-height: 1.75; }
  .resources-link { font-size: 14px; margin-top: 24px; color: var(--text-mute); }
  .resources-link a { text-decoration: underline; text-underline-offset: 4px; }
  .consulting-contact { padding-bottom: 80px; }
  .contact-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .contact-panel .section-intro { margin: 0; }
  .contact-panel .text-link { display: inline-block; margin-top: 24px; }
  .consulting-form { display: flex; flex-direction: column; gap: 20px; }
  .consulting-form label { text-transform: none; letter-spacing: 0; color: var(--text-soft); font-size: 14px; }
  .consulting-form input, .consulting-form textarea { font-size: 16px; line-height: 1.6; }
  .consulting-form textarea { resize: vertical; }
  .consulting-form .btn { justify-content: center; }
  .form-note { color: var(--text-mute); font-size: 12px; line-height: 1.65; }
  .consulting-hero :is(a, button):focus-visible, .consulting-section :is(a, button, input, textarea, summary):focus-visible { outline: 3px solid var(--teal-light); outline-offset: 5px; }
  @media (max-width: 1100px) { .consulting-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .friction-panel, .experience-panel { gap: 32px; } }
  @media (max-width: 900px) {
    .consulting-page {
      background-size: auto, 1200px 675px;
      background-position: center, 56% top;
    }
    .consulting-hero { padding-block: 52px 28px; }
    .consulting-section { padding-block: 28px; scroll-margin-top: 84px; }
    .hero-lead { font-size: 21px; }
    .hero-body { font-size: 17px; }
    .friction-panel, .experience-panel, .consulting-faqs, .contact-panel { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .customer-panel, .contact-panel { padding: 26px; }
    .contact-panel .section-intro { margin-bottom: 6px; }
    .consulting-contact { padding-bottom: 52px; }
  }
  @media (max-width: 640px) {
    .consulting-grid, .question-list, .example-grid, .consulting-steps { grid-template-columns: minmax(0, 1fr); }
    .consulting-hero h1 { max-width: 18ch; }
    .hero-actions { align-items: stretch; gap: 20px; }
    .hero-actions .btn { width: 100%; justify-content: center; text-align: center; }
    .hero-actions .text-link { width: 100%; text-align: center; }
    .consulting-area { padding: 24px 22px; }
    .customer-panel, .contact-panel { padding: 24px 20px; }
    .message-example { padding: 20px 16px; }
    .desktop-break { display: none; }
    .consulting-steps { gap: 24px; }
    .consulting-form .btn { white-space: normal; text-align: center; }
  }
</style>
