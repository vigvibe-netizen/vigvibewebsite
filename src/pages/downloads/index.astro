---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('downloads')).sort((a, b) => a.data.order - b.data.order);

/* One section per AI tool. A tool only appears once it has something in it. */
const tools = [
  { name: 'Claude', note: 'Drop the file into a Claude Project or install it as a Skill.' },
  { name: 'ChatGPT', note: 'Import as a Custom GPT or paste into a project instruction set.' },
  { name: 'Gemini', note: 'Use as a Gem inside Google Workspace.' }
];
const groups = tools
  .map(t => ({ ...t, items: all.filter(d => d.data.platform === t.name) }))
  .filter(g => g.items.length);

const hero = all.find(d => d.data.featured);
const href = d => d.data.externalUrl || d.data.file;
const label = d => d.data.externalUrl ? 'Open in ' + d.data.platform + ' →' : 'Download →';
---
<Base
  title="AI Skills for creative teams"
  description="Free Claude Skills, Custom GPTs, and Gemini Gems for creative strategy, copywriting, and briefs."
  active="AI Skills"
  overlayHeader={true}
>
  <PageHeader
    title="AI Skills"
    eyebrow="Free · no email required"
    intro="Skills I use on client work, organized by the tool they run in. Each one covers a part of creative production that repeats — strategy, copy, briefs. Download it, drop it into your own workspace, edit as needed."
    image="/images/photo-band.jpg"
    focal="center 44%"
  />

  {hero && (
    <section class="wrap" style="padding-top:34px">
      <div class="card card--priority feat">
        <div>
          <div class="eyebrow eyebrow--orange" style="font-size:10.5px;margin-bottom:14px">Available now · {hero.data.platform} · {hero.data.type}</div>
          <h2 style="font-weight:800;font-size:30px;line-height:1.16;color:var(--text-bright);margin-bottom:12px">{hero.data.title}</h2>
          <p style="font-size:15.5px;line-height:1.65;color:var(--text-mute);margin-bottom:18px">{hero.data.description}</p>
          <div class="chips" style="margin-bottom:22px">
            {hero.data.tags.map(t => <span class="tag" style="padding:6px 12px;font-size:11.5px">{t}</span>)}
            <span class="tag" style="padding:6px 12px;font-size:11.5px">{hero.data.fileLabel}</span>
          </div>
          <a class="btn btn--action" href={href(hero)} download>Download the skill</a>
        </div>
        <div class="contents">
          <div class="eyebrow" style="font-size:9px;margin-bottom:12px">What is inside</div>
          {hero.data.contents.map(line => <div>{line}</div>)}
        </div>
      </div>
    </section>
  )}

  {groups.map(g => (
    <section class="wrap" style="padding-top:46px">
      <div class="tool">
        <h2 style="font-weight:700;font-size:22px">{g.name}</h2>
        <span style="font-size:13px;color:var(--text-dim)">{g.note}</span>
      </div>
      <div class="grid-3" style="gap:20px">
        {g.items.map(d => (
          <div class={d.data.comingSoon ? 'card dl dl--soon' : 'card dl'}>
            <div class="row" style="justify-content:space-between;margin-bottom:14px">
              <span class={d.data.comingSoon ? 'eyebrow' : 'eyebrow'} style="font-size:10px">{d.data.type}</span>
              <span style="font-family:var(--font-mono);font-size:10.5px;color:#4A5659">{d.data.fileLabel}</span>
            </div>
            <h3 style="font-weight:700;font-size:19px;margin-bottom:10px">{d.data.title}</h3>
            <p style="font-size:14px;line-height:1.6;color:var(--text-mute);flex:1">{d.data.description}</p>
            <div class="dl__foot">
              {d.data.comingSoon
                ? <span class="soon">Coming soon</span>
                : <a href={href(d)} style="font-size:13px;font-weight:600" download>{label(d)}</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap" style="padding-top:46px;padding-bottom:20px"></section>

  <Newsletter heading="New skills as I build them." body="Twice a month with the newsletter. No separate list." cta="Get them" />
</Base>

<style>
  .feat { display: grid; grid-template-columns: 1.15fr .85fr; gap: 34px; padding: 30px 32px; }
  .contents {
    background: var(--ink); border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 20px 22px; font-family: var(--font-mono); font-size: 11.5px;
    line-height: 1.9; color: #C3CBCC;
  }
  .tool {
    display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap;
    padding-bottom: 14px; margin-bottom: 22px; border-bottom: 1px solid var(--line);
  }
  .dl { display: flex; flex-direction: column; }
  .dl--soon { border-top-color: var(--line-strong); opacity: .72; }
  .dl__foot {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line);
  }
  .soon {
    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--text-faint);
  }
  @media (max-width: 900px) {
    .feat { grid-template-columns: 1fr; gap: 22px; padding: 24px 20px; }
  }
</style>
