---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('downloads')).sort((a, b) => a.data.order - b.data.order);
const platforms = ['Claude', 'ChatGPT', 'Gemini'];
const counts = {};
platforms.forEach(p => { counts[p] = all.filter(d => d.data.platform === p).length; });
const hero = all.find(d => d.data.featured);
const rest = all.filter(d => !d.data.featured);
const href = d => d.data.externalUrl || d.data.file;
const label = d => d.data.externalUrl ? 'Open in ' + d.data.platform + ' →' : 'Download →';
---
<Base
  title="Downloads for creative teams"
  description="Free Claude Skills, Custom GPTs, and Gemini Gems for briefs, triage, deck structure, and brand checks."
  active="Downloads"
  overlayHeader={true}
>
  <PageHeader
    title="Downloads for creative teams"
    eyebrow="Free · Claude, ChatGPT, Gemini"
    intro="Skills, loops, and prompt sets I actually use on client work. Built for the parts of creative production that repeat — briefs, triage, deck structure, brand checks. Download, drop into your own workspace, edit as needed."
    image=""
    focal="center 44%"
  />

  <section class="wrap" style="padding-top:26px">
    <div class="row" style="gap:10px;padding-bottom:24px;border-bottom:1px solid var(--line);flex-wrap:wrap">
      {platforms.map((p, i) => (
        <button type="button" class={i === 0 ? 'tag tag--on' : 'tag'} data-plat={p}>{p} <span style="opacity:.7;font-size:11.5px">{counts[p]}</span></button>
      ))}
      <span style="margin-left:auto;font-size:12.5px;color:var(--text-faint)">Free · no email required</span>
    </div>
  </section>

  {hero && (
    <section class="wrap" style="padding-top:30px" data-plat-group={hero.data.platform}>
      <div class="card card--priority hero">
        <div>
          <div class="eyebrow eyebrow--orange" style="font-size:10.5px;margin-bottom:14px">Most downloaded · {hero.data.type}</div>
          <h2 style="font-weight:800;font-size:30px;line-height:1.16;color:var(--text-bright);margin-bottom:12px">{hero.data.title}</h2>
          <p style="font-size:15.5px;line-height:1.65;color:var(--text-mute);margin-bottom:18px">{hero.data.description}</p>
          <div class="chips" style="margin-bottom:22px">
            {hero.data.tags.map(t => <span class="tag" style="padding:6px 12px;font-size:11.5px">{t}</span>)}
            <span class="tag" style="padding:6px 12px;font-size:11.5px">{hero.data.fileLabel}</span>
          </div>
          <a class="btn btn--action" href={href(hero)} download>Download the skill</a>
        </div>
        <div class="contents">
          <div class="eyebrow" style="font-size:9px;margin-bottom:12px">Contents</div>
          {hero.data.contents.map(line => <div>{line}</div>)}
        </div>
      </div>
    </section>
  )}

  <section class="wrap" style="padding-top:30px;padding-bottom:20px">
    <div class="grid-3" style="gap:20px">
      {rest.map(d => (
        <div class="card dl" data-plat-group={d.data.platform}>
          <div class="row" style="justify-content:space-between;margin-bottom:14px">
            <span class="eyebrow" style="font-size:10px">{d.data.type}</span>
            <span style="font-family:var(--font-mono);font-size:10.5px;color:#4A5659">{d.data.fileLabel}</span>
          </div>
          <h3 style="font-weight:700;font-size:19px;margin-bottom:10px">{d.data.title}</h3>
          <p style="font-size:14px;line-height:1.6;color:var(--text-mute);flex:1">{d.data.description}</p>
          <div class="dl__foot">
            <a href={href(d)} style="font-size:13px;font-weight:600">{label(d)}</a>
            {d.data.downloadCount > 0 && <span style="font-size:12px;color:var(--text-faint)">{d.data.downloadCount} downloads</span>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <Newsletter heading="New agents as I build them." body="Twice a month with the newsletter. No separate list." cta="Get them" />
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.15fr .85fr; gap: 34px; padding: 30px 32px; }
  .contents {
    background: var(--ink); border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 20px 22px; font-family: var(--font-mono); font-size: 11.5px;
    line-height: 1.9; color: #C3CBCC;
  }
  .dl { display: flex; flex-direction: column; }
  .dl__foot {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line);
  }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; gap: 22px; padding: 24px 20px; } }
</style>

<script is:inline>
  var tabs = document.querySelectorAll('[data-plat]');
  function show(platform) {
    document.querySelectorAll('[data-plat-group]').forEach(function (el) {
      el.hidden = el.getAttribute('data-plat-group') !== platform;
    });
  }
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) { t.classList.toggle('tag--on', t === tab); });
      show(tab.getAttribute('data-plat'));
    });
  });
  show('Claude');
</script>
