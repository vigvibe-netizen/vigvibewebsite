---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact VigVibe"
  description="Tell me what you need in two sentences. I'll tell you what it would take — within one business day."
  tone="contact"
>
  <section class="wrap contact-page">
    <p class="eyebrow" style="margin-bottom:18px">One project · One email</p>
    <h1 style="font-weight:800;font-size:44px;line-height:1.08;margin-bottom:16px">Contact VigVibe</h1>
    <p style="font-size:18px;line-height:1.6;color:var(--text-mute);max-width:52ch;margin-bottom:40px">Tell me what you're working on. I'll tell you if I can help and what it would take. No call required, no pitch, no invoice for the advice.</p>

    <form
      name="contact-book"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      action="/thanks"
      class="book-form"
    >
      <input type="hidden" name="form-name" value="contact-book" />
      <p hidden><label>Leave blank <input name="bot-field" /></label></p>

      <div class="field-row">
        <div class="field">
          <label for="b-name">Your name</label>
          <input type="text" id="b-name" name="name" placeholder="Scott Vigneault" required />
        </div>
        <div class="field">
          <label for="b-company">Company</label>
          <input type="text" id="b-company" name="company" placeholder="Optional" />
        </div>
      </div>

      <div class="field">
        <label for="b-email">Email</label>
        <input type="email" id="b-email" name="email" placeholder="you@company.com" required />
      </div>

      <div class="field">
        <label for="b-need">What do you need?</label>
        <select id="b-need" name="need">
          <option value="">Pick the closest one</option>
          <option>A deck fixed by Friday</option>
          <option>A campaign built out</option>
          <option>A logo or brand refresh</option>
          <option>A website designed</option>
          <option>Event or booth graphics</option>
          <option>Our workflow untangled</option>
          <option>Something else</option>
        </select>
      </div>

      <div class="field">
        <label for="b-message">Tell me more — two sentences is enough</label>
        <textarea id="b-message" name="message" rows="5" required placeholder="Q3 product launch — need ads, a landing page, and an email sequence. Kickoff is in two weeks."></textarea>
      </div>

      <button class="btn btn--action" type="submit" style="font-size:16px;width:100%;justify-content:center">Send it over</button>
      <p style="font-size:13px;line-height:1.55;color:var(--text-faint);text-align:center;margin-top:12px">I reply within one business day. No call required.</p>
    </form>

    <div class="contact-alt">
      <div>
        <div class="eyebrow" style="font-size:10.5px;margin-bottom:8px">Prefer email</div>
        <p style="font-size:15px;color:var(--text-mute)"><a href="mailto:scott@vigvibe.com">scott@vigvibe.com</a></p>
      </div>
      <div>
        <div class="eyebrow" style="font-size:10.5px;margin-bottom:8px">Where I work</div>
        <p style="font-size:15px;color:var(--text-mute)">Haverhill, MA · remote across US time zones</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-page {
    max-width: 640px;
    padding-top: 72px;
    padding-bottom: 96px;
  }

  .book-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 3rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .contact-alt {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .field-row { grid-template-columns: 1fr; }
    .contact-page { padding-top: 44px; padding-bottom: 64px; }
  }
</style>
